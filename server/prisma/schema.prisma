generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  HOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         Role      @default(GUEST)
  createdAt    DateTime  @default(now())
  garages      Garage[]
  bookings     Booking[]
}

model Garage {
  id          String    @id @default(uuid())
  title       String
  description String
  type        String
  pricePerDay Decimal   @db.Decimal(10, 2)
  address     String
  city        String
  lat         Float?
  lng         Float?
  photos      String[]
  hostId      String
  host        User      @relation(fields: [hostId], references: [id])
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id        String        @id @default(uuid())
  garageId  String
  userId    String
  startDate DateTime
  endDate   DateTime
  status    BookingStatus @default(PENDING)
  garage    Garage        @relation(fields: [garageId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}